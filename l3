@njit
def BC(x0,y0,x1,y1,x2,y2,x,y,d):
    lambda0=(((x-x2)*(y1-y2)-(x1-x2)*(y-y2))/d)
    lambda1=(((x0-x2)*(y-y2)-(x-x2)*(y0-y2))/d)
    lambda2=1.0-lambda0-lambda1
    return lambda0,lambda1,lambda2

@njit
def calculate_normal(p0,p1,p2):
    ux = p1[0]-p2[0]
    uy = p1[1]-p2[1]
    uz = p1[2]-p2[2]

    vx = p1[0]-p0[0]
    vy = p1[1]-p0[1]
    vz = p1[2]-p0[2]
    nx = uy*vz-uz*vy
    ny = uz*vx-ux*vz
    nz = ux*vy-uy*vx
    return nx, ny, nz

@njit
def transform_vertex(x,y,z,beta,tX,tY,tZ):
    x_new =x*cos(beta)+z*sin(beta)+tX
    y_new =y+tY
    z_new =-x*sin(beta)+z*cos(beta)+tZ

    return x_new,y_new,z_new

@njit
def draw_triangle(img_mat,z_buffer,px0,py0,z0,px1,py1,z1,px2,py2,z2,cos,Color_1,beta,tX,tY,tZ):
    color=(Color_1*cos,0,0)
    height=len(img_mat)
    width=len(img_mat[0])
    xmin=floor(max(0,min(px0,px1,px2)))
    ymin=floor(max(0,min(py0,py1,py2)))
    width_x=width-1
    height_y=height-1
    xmax=ceil(min(width_x, max(px0,px1,px2)))
    ymax=ceil(min(height_y,max(py0,py1,py2)))


    denom=((px0-px2)*(py1-py2)-(px1-px2)*(py0-py2))
    if denom==0:
        return
    for y in range(ymin, ymax+1):
        for x in range(xmin, xmax+1):
            l0,l1,l2=BC(px0,py0,px1,py1,px2,py2,x+0.5,y+0.5,denom)

            if l0>=0 and l1>=0 and l2>=0:
                z_hat=l0*z0+l1*z1+l2*z2
                if z_hat<z_buffer[y][x]:
                    z_buffer[y][x]=z_hat
                    img_mat[y][x][0]=color[0]
                    img_mat[y][x][1]=color[1]
                    img_mat[y][x][2]=color[2]

@njit
def render_model(v, f, img_mat, z_buffer, scale_1, H, W, Color_1,beta,tX,tY,tZ,perspective):
    for i in range(len(f)):
        x0 = v[f[i][0]][0]
        y0 = v[f[i][0]][1]
        z0 = v[f[i][0]][2]

        x1 = v[f[i][1]][0]
        y1 = v[f[i][1]][1]
        z1 = v[f[i][1]][2]

        x2 = v[f[i][2]][0]
        y2 = v[f[i][2]][1]
        z2 = v[f[i][2]][2]

        x0,y0,z0 = transform_vertex(x0,y0,z0,beta,tX,tY,tZ)
        x1,y1,z1 = transform_vertex(x1,y1,z1,beta,tX,tY,tZ)
        x2,y2,z2 = transform_vertex(x2,y2,z2,beta,tX,tY,tZ)
        if perspective:
            px0 = x0*scale_1/z0 +W/2
            py0 = -y0*scale_1/z0 +H/2
            px1 = x1*scale_1/z1+ W/2
            py1 = -y1*scale_1/z1+ H/2
            px2 = x2*scale_1/z2+ W/2
            py2 = -y2*scale_1/z2+ H/2
        else:
            px0 = x0*scale_1 +W/2
            py0 = -y0*scale_1 +H/2
            px1 = x1*scale_1+ W/2
            py1 = -y1*scale_1+ H/2
            px2 = x2*scale_1+ W/2
            py2 = -y2*scale_1+ H/2


        xyz0 = (x0, y0, z0)
        xyz1 = (x1, y1, z1)
        xyz2 = (x2, y2, z2)

        nx, ny, nz = calculate_normal(xyz0, xyz1, xyz2)
        norm_n = sqrt(nx*nx+ny*ny+nz*nz)
        if norm_n == 0:
            continue
        cos = nz / norm_n
        if cos < 0:
            draw_triangle(img_mat, z_buffer, px0, py0, z0,px1, py1, z1,px2, py2, z2,cos, Color_1,beta,tX,tY,tZ)
    return 1

class Scene:
    def __init__(self, filename):
        self.v=[]
        self.f=[]
        file=open('model.obj')
        for s in file:
            sp=s.split()
            if(sp[0]=='v'):
                self.v.append([float(sp[1]),float(sp[2]),float(sp[3])])
            elif(sp[0]=='f'):
                self.f.append([int(sp[1].split("/")[0])-1,int(sp[2].split("/")[0])-1,int(sp[3].split("/")[0])-1])
        self.v=np.array(self.v)
        self.f=np.array(self.f)

class Render:
    def __init__(self,scale_1,H,W,D,Color_1):
        self.perspective= True
        self.beta=0.0
        self.tX=0.0
        self.tY=0.0
        self.tZ=1.0
        self.H=H
        self.W=W
        self.D=D
        self.img_mat= np.zeros((self.H,self.W,self.D), dtype=np.uint8)
        self.z_buffer=np.full((self.H,self.W),np.inf , dtype=np.float32)
        self.scale_1=scale_1
        self.Color_1=Color_1
    
    def clear_buffer(self):
        self.img_mat.fill(0)
        self.z_buffer.fill(np.inf)

    def render(self, scene):
        self.clear_buffer()
        render_model(scene.v, scene.f, self.img_mat, self.z_buffer, self.scale_1, self.H, self.W,self.Color_1,self.beta,self.tX,self.tY,self.tZ, self.perspective)

        
class App:
    def __init__(self, scene, renderer, win_w, win_h):
        self.scene = scene
        self.renderer = renderer
        self.root = tk.Tk()
        self.root.geometry(f"{win_w}x{win_h}")
        self.canvas = tk.Canvas(self.root, bg='black', highlightthickness=0)
        self.canvas.pack(fill='both', expand=True)
        self.canvas.focus_set()
        self.canvas.bind('<Configure>', lambda e: self._refit())
        self.root.bind('<Key>', self.on_key)

        self.photo = None
        self.full_image = None

        self.render()

    def on_key(self, event):
        k = event.keysym

        if k == 'plus':
            self.renderer.scale_1 *= 1.1
        elif k == 'minus':
            self.renderer.scale_1 /= 1.10
        elif k == 'Left':
            self.renderer.beta -= 0.1
        elif k == 'Right':
            self.renderer.beta += 0.1
        elif k == 'd':
            self.renderer.tX += 0.005
        elif k == 'a':
            self.renderer.tX -= 0.005
        elif k == 'Up':
            self.renderer.tY += 0.005
        elif k == 'Down':
            self.renderer.tY -= 0.005
        elif k == 's':
            self.renderer.tZ -= 0.005
        elif k == 'w':
            self.renderer.tZ += 0.005
        elif k == 'p':
            self.renderer.perspective=not self.renderer.perspective
        elif k == 'space':
            self.render.tZ=0.005
            Image.fromarray(self.renderer.img).save('sphere.png')
            return 'break'
        else:
            return
        
        self.render()
        return 'break'

    def render(self):
        self.renderer.render(self.scene)
        self.full_image = Image.fromarray(self.renderer.img_mat)
        self._refit()

    def _refit(self):
        if self.full_image is None: return
        ww = self.canvas.winfo_width()
        wh = self.canvas.winfo_height()
        if ww < 10 or wh < 10: return
        s = min(ww / self.renderer.W, wh / self.renderer.H)
        dw = max(1, int(self.renderer.W * s))
        dh = max(1, int(self.renderer.H * s))
        disp = self.full_image.resize((dw, dh), Image.BILINEAR)
        self.photo = ImageTk.PhotoImage(disp)
        self.canvas.delete('all')
        self.canvas.create_image(ww // 2, wh // 2, image=self.photo)   

    def run(self):
        self.root.mainloop()

